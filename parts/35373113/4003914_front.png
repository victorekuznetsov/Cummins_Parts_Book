<html>

<head>
    <title>Unexpected Service Interruption</title>
    <style>
        html,
        body {
            margin: 0;
            padding: 0;
            overflow: hidden;
        }

        body {
            height: 100%;
            display: flex;
            flex-flow: column wrap;
            font-family: 'Helvetica Neue 55', Arial, sans-serif;
        }

        .header {
            width: 100%;
            color: white;
            display: flex;
            flex-wrap: wrap;
            padding: 10px 5px;
            align-items: center;
            background: linear-gradient(to top, #dc2028, #af0d1f);
            background: -webkit-gradient(linear, left bottom, left top, from(#dc2028), to(#af0d1f));
        }

        .header>* {
            flex: auto;
        }

        .body {
            flex: auto;
            display: inline-block;
            position: relative;
        }

        .body .content {
            text-align: center;
        }

        .body .content h2 {
            font-size: 2em;
            font-weight: bold;
        }

        .body .content .heading {
            display: inline-flex;
            flex-flow: row wrap;
            align-items: center;
            justify-content: center;
        }

        .body .content .heading img {
            width: 5%;
            margin-right: 10px;
        }

        .body a {
            color: inherit;
            text-decoration: none;
        }

        .footer {
            color: #ccc;
            font-size: 13px;
            padding: 10px 5px;
            position: relative;
            background-color: black;
            padding-left: 5%;
            overflow: hidden;
        }

        .footer .foot-icon+img {
            margin-bottom: -10px;
            transform: scale(0.75);
        }

        .footer .foot-icon {
            position: absolute;
            left: -13px;
            bottom: -13px;
            margin-left: -7px;
            transform: scale(0.6);
        }
    </style>
</head>

<body>
    <div class="header">
        <div class="logo">
            <img src="data:image/png;base64,"
                alt="" />
        </div>
    </div>
    <div class="body">
        <div class="content">
            <div class="heading">
                <img
                    src="data:image/png;base64," />
                <h2>Unexpected Service Interruption</h2>
            </div>
            <div>
				We're experiencing some technical difficulties and are working on a fix with utmost urgency.
				This message will be automatically removed once the website is back online.
            </div>
        </div>
    </div>
    <div class="footer">
        <div class="foot-icon">
            <img src="data:image/gif;base64,"
                alt="" />
        </div>
        <img src="data:image/png;base64,"
            alt="" />&nbsp;&copy;&nbsp;2000-2025 Cummins Inc., Box 3005, Columbus, IN 47202-3005 U.S.A.
    </div>
</body>

</html>